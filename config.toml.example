# Copy this file to `config.toml` in the directory you run Heretic from.
# Running `heretic <model>` will then use these settings.
#
# TOML rule: top-level keys must appear BEFORE the first [table] header,
# otherwise they end up inside that table and are silently ignored.

# ---- Top-level settings ----
max_response_length = 300
export_strategy = "adapter"
n_trials = 400

# Let the model generate its own reasoning (as dictated by its chat template)
# instead of pre-filling a closed reasoning block. Refusals are then detected
# only in the answer after the reasoning completes. max_thought_length bounds
# the reasoning; max_response_length bounds only the final answer. Responses
# that never finish reasoning (no closing tag) are treated as refusals.
# Residuals/module I/O (the ablation direction) and KL logits are captured at
# the first answer token, matching where the behavior of interest lives.
generate_chain_of_thought = true
max_thought_length = 8192

# ---- Scorers ----
# Refusals on harmful prompts, plus a 2x2 KL matrix:
#   {harmful, harmless} prompts x {first token, first answer token}.
# "first token" is the start of the response (start of reasoning);
# "first answer token" is the first token after the reasoning block closes.
# Only KeywordRate and the harmless answer-anchored KL are optimized; the other
# three are diagnostics ("none") that are still computed and shown per trial.
# NOTE: "none" scorers still run every trial, so the answer-anchored ones are not
# free (they generate the model's reasoning for their prompt set).
scorers = [
    { plugin = "heretic.scorers.keyword_rate.KeywordRate", optimization = "minimize" },
    { plugin = "heretic.scorers.kl_divergence.KLDivergence", optimization = "minimize", instance_name = "harmless-answer" },
    { plugin = "heretic.scorers.kl_divergence.KLDivergence", optimization = "none", instance_name = "harmful-answer" },
    { plugin = "heretic.scorers.kl_divergence.KLDivergence", optimization = "none", instance_name = "harmless-first" },
    { plugin = "heretic.scorers.kl_divergence.KLDivergence", optimization = "none", instance_name = "harmful-first" },
]

[scorer.KLDivergence_harmless-answer]
capture_position = "first_answer_token"
[scorer.KLDivergence_harmless-answer.prompts]
dataset = "mlabonne/harmless_alpaca"
split = "test[:100]"
column = "text"

[scorer.KLDivergence_harmful-answer]
capture_position = "first_answer_token"
[scorer.KLDivergence_harmful-answer.prompts]
dataset = "mlabonne/harmful_behaviors"
split = "test[:100]"
column = "text"

[scorer.KLDivergence_harmless-first]
capture_position = "first_token"
[scorer.KLDivergence_harmless-first.prompts]
dataset = "mlabonne/harmless_alpaca"
split = "test[:100]"
column = "text"

[scorer.KLDivergence_harmful-first]
capture_position = "first_token"
[scorer.KLDivergence_harmful-first.prompts]
dataset = "mlabonne/harmful_behaviors"
split = "test[:100]"
column = "text"

# ---- Modifier ----
# The modifier defaults to ARA, so no `modifiers = [...]` line is needed.
[modifier.ARA]
lora_rank = 128
filter_prompts = true
