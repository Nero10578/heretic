# Copy this file to `config.toml` in the directory you run Heretic from.
# Running `heretic <model>` will then use these settings.
#
# TOML rule: top-level keys must appear BEFORE the first [table] header,
# otherwise they end up inside that table and are silently ignored.

# ---- Top-level settings ----
max_response_length = 300
export_strategy = "adapter"

# Quantization for the HuggingFace editor model ("none" or "bnb_4bit"). park_editor
# requires "none", because the 4-bit dequantization path is not staged onto the GPU.
quantization = "none"

# Fixed batch size (non-zero skips auto-tuning; 0 = auto).
batch_size = 8

# Batch size for the capture forwards (KL logits, residuals, module I/O). These run one
# forward over prompt + full reasoning, so their peak VRAM and kernel size scale with
# batch times sequence length. Keep small to avoid OOM / driver launch timeouts.
# With capture_during_generation enabled, only the fallback forwards remain.
capture_batch_size = 8

# Capture KL logits and module I/O at the capture positions while the reasoning is
# generated, instead of re-forwarding prompt + reasoning afterwards. Roughly halves
# initialization and per-trial capture cost, and avoids the large capture kernels behind
# OOM / launch timeouts. Requires the reasoning block to close within the budget (prompts
# that never close fall back to the separate forward). Runs through a different batching
# and kernel path, so it can shift results slightly.
capture_during_generation = true

n_trials = 100
n_startup_trials = 30
print_debug_information = true

# Reuse cached base-model initialization (filtered prompt sets, KL baselines, ARA module
# I/O) across runs, so resuming skips the expensive initialization instead of recomputing
# it. Automatically invalidated when the relevant settings or the Heretic source change.
init_cache = true

# Attention backend. "auto" uses FlashAttention-2/3 when the flash-attn package is
# installed (fastest for the long reasoning sequences), otherwise the library default
# (usually SDPA). Explicit options: flash_attention_2/3/4, sdpa, eager.
# Note: FlashAttention is not bit-exact with SDPA, so it changes results slightly.
attn_implementation = "auto"


# Let the model generate its own reasoning (as dictated by its chat template)
# instead of pre-filling a closed reasoning block. Refusals are then detected
# only in the answer after the reasoning completes. max_thought_length bounds
# the reasoning; max_response_length bounds only the final answer. Responses
# that never finish reasoning (no closing tag) are treated as refusals.
# Residuals/module I/O (the ablation direction) and KL logits are captured at
# the first answer token, matching where the behavior of interest lives.
generate_chain_of_thought = true
max_thought_length = 4096

# Abort a prompt's generation as soon as it falls into a repetition loop, so a broken
# model doesn't burn the full token budget. Such responses are counted as refusals.
# Optionally prune the whole trial when at least abort_broken_trial_fraction of prompts
# loop; off by default so the optimizer still gets the (worst-case) score for that region.
abort_repeating_generation = true
repetition_period_max = 16
repetition_min_repeats = 12
abort_broken_trials = false
abort_broken_trial_fraction = 0.9

# Gemma 4's chat template only starts reasoning when enable_thinking is set;
# without it, the template opens and immediately closes the thought channel and
# the model answers directly. Forwarded to apply_chat_template.
chat_template_kwargs = { enable_thinking = true }

# ---- Scorers ----
# Refusals on harmful prompts, plus KL divergence on harmless prompts at two positions:
# "first token" is the start of the response (start of reasoning);
# "first answer token" is the first token after the reasoning block closes.
# Only KeywordRate and the harmless answer-anchored KL are optimized; the harmless
# first-token KL is a diagnostic ("none") that is still computed and shown per trial.
#
# filter_prompts trims each evaluation set by the base model's refusal behavior
# (same detection as the modifier's filter_prompts): "keep_refused" keeps only
# prompts the model actually refuses (harmful sets), "drop_refused" drops refused
# prompts (harmless sets). This makes refusals/KL measure only relevant prompts.
scorers = [
    { plugin = "heretic.scorers.keyword_rate.KeywordRate", optimization = "minimize" },
    { plugin = "heretic.scorers.kl_divergence.KLDivergence", optimization = "minimize", instance_name = "harmless-answer" },
    { plugin = "heretic.scorers.kl_divergence.KLDivergence", optimization = "none", instance_name = "harmless-first" },
]

# ---- vLLM evaluation backend (optional) ----
# When enabled, per-trial scoring (generation plus the KL capture-position distributions)
# is served by a vLLM engine instead of the in-process HuggingFace model. The modifier and
# its module I/O capture always stay on HuggingFace. With park_editor, the HuggingFace
# model is moved to CPU memory after its one-time initialization so vLLM owns the GPU
# alone (and the bf16 editor and a quantized vLLM copy can share a single smaller GPU).
[vllm]
enabled = true
model = "/home/arli/models/gemma-4-31B-it-AWQ-8bit"   # empty = main model
park_editor = true               # move the HF model to CPU after init so vLLM owns the GPU
mode = "inprocess"               # only "inprocess" is implemented
dtype = "auto"                   # "auto" = use the checkpoint's own dtype/quantization
tensor_parallel_size = 1
gpu_memory_utilization = 0.9     # lower this if the ARA staging step OOMs during trials
max_model_len = 8192             # 0 = derive from the model; must fit prompt + max tokens
max_lora_rank = 128              # must be >= modifier.ARA.lora_rank

[scorer.KeywordRate]
filter_prompts = "keep_refused"

[scorer.KLDivergence_harmless-answer]
capture_position = "first_answer_token"
filter_prompts = "drop_refused"
[scorer.KLDivergence_harmless-answer.prompts]
dataset = "mlabonne/harmless_alpaca"
split = "test[:100]"
column = "text"

[scorer.KLDivergence_harmless-first]
capture_position = "first_token"
filter_prompts = "drop_refused"
[scorer.KLDivergence_harmless-first.prompts]
dataset = "mlabonne/harmless_alpaca"
split = "test[:100]"
column = "text"

# ---- Modifier ----
# The modifier defaults to ARA, so no `modifiers = [...]` line is needed.
[modifier.ARA]
lora_rank = 128
filter_prompts = true
# Use TF32 for the float32 inner optimization (avoids cudaErrorLaunchTimeout on long
# reasoning, and much faster). Set false for bit-exact fp32.
use_tf32 = true
